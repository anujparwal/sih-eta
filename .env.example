# Local development only. Copy to .env; never commit real credentials.
POSTGRES_DB=sih_eta
POSTGRES_USER=sih_eta
POSTGRES_PASSWORD=sih_eta_local
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Browser-visible URL, not a Compose service hostname. Update if BACKEND_PORT changes.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Shared per-peer ingestion budget and isolated Redis namespace.
INGEST_RATE_LIMIT_PER_MINUTE=120
REDIS_KEY_PREFIX=sih-eta:v1

# Reviewed synthetic next-station model; false forces carryover-only predictions.
ETA_MODEL_ENABLED=true

# Optional locally; required for the documented public cloud API. Keep server-side.
# Set the same random value on the backend and simulator; never NEXT_PUBLIC_.
INGEST_API_KEY=
